# Copy to test.properties (which is git-ignored) and fill in for this machine.
# Every line becomes an environment variable for the test JVM: keyCorpus is read as
# SSHBORG_KEY_CORPUS, sshKeyDir as SSHBORG_SSH_KEY_DIR, and so on. A test whose
# settings are missing skips itself, so the suite stays green on a machine that has
# none of this — nothing here may ever be committed.

# ── Corpora of real files, kept outside the repo ────────────────────────────────
# Throwaway encrypted keys written by a real ssh-keygen (issue #18). The README in
# that directory says which key uses which passphrase.
keyCorpus=/path/to/key-test
keyCorpusPassphrase=the passphrase those keys were made with
keyCorpusUtf8Passphrase=the one with accents and an emoji in it

# Sample files for the editor: charsets, line endings, binaries, a few MB each.
editorCorpus=/path/to/editor-test

# ── A server to run the integration tests against ───────────────────────────────
# Anything you can already reach: the machine the tests run on is the simplest one.
# The keys in sshKeyDir have to be authorized there (their .pub in authorized_keys),
# and they are throwaway keys made for this, never keys you use for anything else.
sshHost=127.0.0.1
sshPort=22
sshUser=your-login
sshKeyDir=/path/to/ssh-test
sshKeyPassphrase=the passphrase those keys were made with
